 'use strict';

+// Bound every AST entry point before any recursive walker runs.
+// Ignore parent/prev links, which intentionally point back into the tree.
+exports.assertDepth = ast => {
+  const pending = [[ast, ast.type === 'root' ? 0 : 1]];
+  while (pending.length > 0) {
+    const [node, depth] = pending.pop();
+    if (node.nodes) {
+      if (depth > 100) {
+        throw new SyntaxError('braces nesting exceeds 100 levels');
+      }
+      for (const child of node.nodes) {
+        pending.push([child, depth + 1]);
+      }
+    }
+  }
