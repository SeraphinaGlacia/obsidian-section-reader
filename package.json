{
  "name": "obsidian-section-reader",
  "version": "0.2.0",
  "description": "Read long Markdown notes one section at a time, with native links, embeds, task interactions, and reading progress preserved.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "typecheck:min": "tsc -p tsconfig.min.json --noEmit --skipLibCheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run typecheck:min && npm run lint && npm run test && npm run test:release-checks && npm run build && npm run check:package",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "check:package": "node scripts/check-package.mjs",
    "test:release-checks": "node --test scripts/release-checks.node.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "section-reader",
    "markdown",
    "reading"
  ],
  "author": "Xinlei Zhou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeraphinaGlacia/obsidian-section-reader.git"
  },
  "homepage": "https://github.com/SeraphinaGlacia/obsidian-section-reader#readme",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.11.0",
    "jsdom": "^28.1.0",
    "obsidian": "^1.13.1",
    "obsidian-min": "npm:obsidian@1.8.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "moment": "2.31.0"
  }
}
